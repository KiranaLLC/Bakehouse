# Copy this file to .env and fill in your values. Never commit .env.

# Stripe secret key: https://dashboard.stripe.com/apikeys
# Use sk_test_... while testing, sk_live_... when you go live.
STRIPE_SECRET_KEY=sk_test_replace_me

# The public address of the website (no trailing slash). Stripe sends
# customers back here after paying or cancelling.
SITE_URL=http://localhost:3000

# Only needed if the website pages are hosted somewhere other than this
# server (e.g. GitHub Pages). Comma-separated list of allowed site origins.
# ALLOWED_ORIGINS=https://www.kiranabakehouse.com
